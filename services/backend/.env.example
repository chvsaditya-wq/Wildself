# Copy this file to .env (git-ignored) and fill in your own values.
# Never commit .env. Never paste these values into chat or issues.

NODE_ENV=development
LOG_LEVEL=info

# Local database created with db/local-setup.md. Use the password you chose there.
DATABASE_URL=postgres://wildself_app:CHANGE_ME@localhost:5432/wildself_dev
# Only for integration tests; a separate database that tests may wipe.
TEST_DATABASE_URL=postgres://wildself_app:CHANGE_ME@localhost:5432/wildself_test

HOST=127.0.0.1
PORT=3000

# deny-all (default, safe) or dev-stub (local only: "Authorization: Bearer dev:<uuid>").
AUTH_MODE=dev-stub

# Optional locally; required in production.
# SENTRY_DSN=
